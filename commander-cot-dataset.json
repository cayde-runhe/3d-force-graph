{
  "metadata": {
    "name": "Commander CoT - Operation Planning Dataset",
    "version": "1.0.0",
    "description": "3D Force-Graph visualization dataset for military/combat operation planning Chain-of-Thought workflow. Maps 3d-force-graph technical patterns to the Commander's 6-node CoT process: Intent Understanding (21 Clarities), Situation Assessment, Concept Formation (3 Plans), Plan Development, Simulation Trial, and Effect Evaluation.",
    "generated": "2026-06-07",
    "system": "Commander CoT Intelligence Agent",
    "purpose": "Vibe coding dataset for building the Operation Commander CoT 3D visualization system",
    "dataSource": "3d-force-graph (vasturiano/3d-force-graph v1.80.0) + operation-commander React application"
  },

  "commander_workflow": {
    "name": "指挥官智能体工作流",
    "description": "整体指挥官智能体工作流：上传作战方案 → 意图理解(21项明确) → 情况判断 → 形成3个构想方案 → 选择1个方案 → 制定详细计划 → 仿真推演 → 效果评估 → 决策输出",
    "total_steps": 8,
    "nodes": [
      {
        "id": "intent-understanding",
        "index": 0,
        "label": "意图理解",
        "label_en": "Intent Understanding",
        "color": "#4a9eff",
        "description": "对敌方、我方、战场环境进行21项意图分析明确，包括任务目的、敌方能力、天气地形、时间窗口等",
        "status": "21项明确分析",
        "graph_pattern": "auto-colored nodes by category, DAG layout for causal analysis",
        "key_features": ["nodeAutoColorBy", "dagMode", "nodeLabel", "onNodeClick", "nodeThreeObject"],
        "visualization": {
          "layout": "dag",
          "direction": "lr",
          "node_grouping": "by_category",
          "links": "dependency_arrows"
        }
      },
      {
        "id": "situation-assessment",
        "index": 1,
        "label": "情况判断",
        "label_en": "Situation Assessment",
        "color": "#34d399",
        "description": "对战场态势进行全面评估，识别威胁等级、弱点、机会窗口，制定行动限制条件",
        "status": "态势评估",
        "graph_pattern": "heatmap coloring by threat level, directional particles for flow",
        "key_features": ["nodeColor", "nodeVal", "linkDirectionalParticles", "nodeThreeObject"],
        "visualization": {
          "layout": "force",
          "node_grouping": "by_side",
          "links": "directional_flow"
        }
      },
      {
        "id": "concept-formation",
        "index": 2,
        "label": "形成构想",
        "label_en": "Concept Formation",
        "color": "#fbbf24",
        "description": "基于意图理解和情况判断，形成3个可选构想方案（进攻型、平衡型、保守型）供决策",
        "status": "3个构想方案",
        "graph_pattern": "three parallel clusters, each representing a concept option",
        "key_features": ["nodeThreeObject", "nodeColor", "graph2ScreenCoords", "zoomToFit"],
        "visualization": {
          "layout": "three_clusters",
          "node_grouping": "by_concept",
          "links": "inter_concept_comparison"
        }
      },
      {
        "id": "plan-development",
        "index": 3,
        "label": "制定计划",
        "label_en": "Plan Development",
        "color": "#f97316",
        "description": "对选定方案进行详细规划，制定具体行动步骤、时间线、资源分配、应急预案",
        "status": "详细计划制定",
        "graph_pattern": "timeline/Gantt style DAG with time dimension, expandable nodes",
        "key_features": ["dagMode", "expand-on-click", "nodeLabel", "linkLabel", "onNodeClick"],
        "visualization": {
          "layout": "dag",
          "direction": "td",
          "node_grouping": "by_phase",
          "links": "phase_dependencies"
        }
      },
      {
        "id": "simulation-trial",
        "index": 4,
        "label": "仿真推演",
        "label_en": "Simulation Trial",
        "color": "#a78bfa",
        "description": "在虚拟环境中对作战计划进行实时推演，模拟红蓝双方行动，观察计划执行效果",
        "status": "实时推演",
        "graph_pattern": "live updating graph, animated nodes/links, real-time simulation state",
        "key_features": ["websocket-updates", "pause-resume", "emitParticle", "nodeColor-by-status", "linkDirectionalParticles"],
        "visualization": {
          "layout": "force",
          "node_grouping": "by_force",
          "links": "combat_flow",
          "realTime": true
        }
      },
      {
        "id": "effect-evaluation",
        "index": 5,
        "label": "效果评估",
        "label_en": "Effect Evaluation",
        "color": "#f43f5e",
        "description": "对仿真结果进行全面评估，计算胜率、资源消耗、风险系数，给出最终决策建议",
        "status": "效果评估报告",
        "graph_pattern": "static summary graph with metrics, bloom effect for emphasis",
        "key_features": ["nodeVal", "nodeLabel", "bloom-effect", "camera-auto-orbit", "pauseAnimation"],
        "visualization": {
          "layout": "radial",
          "node_grouping": "by_metric",
          "links": "evaluation_flow"
        }
      }
    ],
    "edges": [
      {"source": "intent-understanding", "target": "situation-assessment", "label": "分析结果"},
      {"source": "situation-assessment", "target": "concept-formation", "label": "态势结论"},
      {"source": "concept-formation", "target": "plan-development", "label": "选定方案"},
      {"source": "plan-development", "target": "simulation-trial", "label": "执行计划"},
      {"source": "simulation-trial", "target": "effect-evaluation", "label": "推演数据"},
      {"source": "effect-evaluation", "target": "intent-understanding", "label": "迭代优化"}
    ]
  },

