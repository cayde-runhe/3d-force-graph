  "3d_force_graph_patterns_for_commander": {
    "description": "3d-force-graph patterns mapped to Commander CoT visualization needs",
    "pattern_mappings": [
      {
        "workflow_node": "意图理解",
        "pattern_id": "P001-P013",
        "recommended_pattern": "DAG with auto-coloring by category",
        "implementation": {
          "layout": "dagMode('lr')",
          "node_coloring": "nodeAutoColorBy('category') — 6 categories (任务/敌方/地形/天气/时间/资源)",
          "node_shapes": "nodeThreeObject — 不同类别用不同几何形状",
          "arrows": "linkDirectionalArrowLength(4)",
          "particles": "linkDirectionalParticles(3)",
          "hover": "onNodeHover — 显示详细分析内容"
        }
      },
      {
        "workflow_node": "情况判断",
        "pattern_id": "P004, P005, P013, P019",
        "recommended_pattern": "Threat heatmap with directional flow",
        "implementation": {
          "layout": "force-directed",
          "node_coloring": "nodeColor — 威胁等级(绿→黄→红)",
          "node_sizing": "nodeVal — 威胁程度数值",
          "flow_arrows": "linkDirectionalParticles(4)",
          "highlight": "onNodeHover — 高亮相关威胁链路"
        }
      },
      {
        "workflow_node": "形成构想",
        "pattern_id": "P007, P008, P015",
        "recommended_pattern": "Three parallel concept clusters",
        "implementation": {
          "layout": "force with custom clustering force",
          "three_clusters": "nodeColor — 3种方案(进攻#e74c3c/平衡#f39c12/保守#3498db)",
          "camera": "点击方案 → cameraPosition飞向该cluster → zoomToFit",
          "clustering_force": "自定义d3Force('cluster')聚类力",
          "selection": "onNodeClick → 高亮选中方案，暗化其他方案"
        }
      },
      {
        "workflow_node": "制定计划",
        "pattern_id": "P009, P011, P002",
        "recommended_pattern": "Expandable timeline DAG",
        "implementation": {
          "layout": "dagMode('td')",
          "phases": "按阶段分层展示",
          "expand": "点击节点 → 展开子行动计划",
          "labels": "nodeLabel显示时间和负责人",
          "link_labels": "linkLabel显示依赖关系"
        }
      },
      {
        "workflow_node": "仿真推演",
        "pattern_id": "P014, P005, P016, P019",
        "recommended_pattern": "Live real-time simulation graph",
        "implementation": {
          "layout": "force-directed",
          "updates": "WebSocket实时推送节点/链路更新",
          "status_coloring": "nodeColor — 单位状态(活跃#34d399/交火#f43f5e/待命#fbbf24)",
          "flow": "linkDirectionalParticles — 兵力流向",
          "pause": "pauseAnimation/resumeAnimation",
          "performance": "forceEngine('ngraph') for large simulations"
        }
      },
      {
        "workflow_node": "效果评估",
        "pattern_id": "P012, P022, P002",
        "recommended_pattern": "Summary metrics with immersive visualization",
        "implementation": {
          "layout": "radial or force-directed",
          "bloom": "UnrealBloomPass post-processing",
          "auto_orbit": "camera auto-orbit for presentation",
          "pause": "pauseAnimation — 冻结展示",
          "metrics": "nodeVal大小表示评估分数"
        }
      }
    ]
  },

