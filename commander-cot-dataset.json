  "react_implementation_notes": {
    "description": "operation-commander React应用中3d-force-graph的使用说明",
    "component_usage": {
      "ForceGraph3DComponent": "位于 src/components/ForceGraph3DComponent.jsx，基于 three-forcegraph 实现",
      "datasets": "位于 public/datasets/，包含 blocks.json, miserables.json, d3-dependencies.csv",
      "routing": "基于 react-router-dom，6个节点页面 + Dashboard + Upload + SimulationRun"
    },
    "data_flow": {
      "upload": "用户上传文本 → sessionStorage存储 → IntentUnderstanding页面读取",
      "intent_understanding": "21项分析 → 生成图数据 → DAG可视化",
      "situation_assessment": "态势评估 → 更新节点威胁等级 → Force Graph更新",
      "simulation": "WebSocket推送 → graphData实时更新 → 状态着色",
      "evaluation": "静态评估报告 → 高亮关键指标 → bloom渲染"
    },
    "performance_considerations": [
      "大节点数时使用 forceEngine('ngraph')",
      "使用 warmupTicks/cooldownTicks 预计算布局",
      "仿真推演中适当降低 nodeResolution",
      "paused状态下自动 pauseAnimation"
    ]
  },

